{
  "schemaVersion": 1,
  "policy": "strict-minimum-external-dependencies",
  "coreOwnedByPGI": [
    "dashboard",
    "api",
    "database",
    "cache",
    "sip_proxy",
    "media_server",
    "ivr",
    "expert_routing",
    "queues",
    "presence",
    "internal_cdr",
    "financial_engine",
    "reconciliation",
    "reporting",
    "monitoring",
    "alerts",
    "audit",
    "backups",
    "deployment"
  ],
  "externalRequired": [
    {
      "role": "sva_host_operator",
      "replaceable": true,
      "allowedResponsibilities": [
        "numbering_resource",
        "sva_interconnection",
        "public_reachability",
        "network_portability",
        "network_collection",
        "contractual_payout"
      ]
    }
  ],
  "externalOptional": [
    "payment_service_provider_if_contractually_required",
    "email_delivery",
    "external_monitoring"
  ],
  "forbiddenHardDependencies": [
    "carrier_specific_dashboard",
    "carrier_specific_ivr",
    "carrier_specific_crm",
    "carrier_specific_business_routing",
    "carrier_specific_data_model"
  ],
  "costGovernance": {
    "defaultForNewPaidServices": "deny_without_proven_need",
    "preferExistingOwnedModules": true,
    "chooseLowestVerifiedTotalCostNotFewestVendors": true,
    "securityComplianceCannotBeWaived": true,
    "requireBeforePaidService": [
      "documented_unavoidable_gap",
      "actual_complete_quote",
      "security_and_legal_review",
      "export_and_exit_path",
      "net_margin_check"
    ],
    "noPaidTelecomHostingBeforeNetworkContract": true,
    "directInterconnectionIsNotCostFree": true,
    "supplierCancellationRequiresEvidenceOfEquivalentService": true
  },
  "numberingAndInterconnection": {
    "own089Block": "requires_explicit_arcep_allocation",
    "currentExternalNetworkMode": "wholesale_partner_not_contracted",
    "candidateNetworkModes": [
      "wholesale_partner",
      "owned_sip_with_wholesale_collection",
      "direct_bilateral_interconnection"
    ],
    "directInterconnectionRequiresOperatorContracts": true,
    "originNetworkReachabilityNeverAssumed": true,
    "collectionAndSettlementNeverAssumed": true
  }
}
