# Copy only to a private voice host configuration directory, mode 0600.
# Use the approved private machine ingress, not a bypass of the public proxy.
PGI_CDR_API_URL=
PGI_CDR_ALLOWED_HOST=
PGI_CDR_NATIVE_DIR=/var/lib/pgi-voice/native-cdr
PGI_CDR_SPOOL_DIR=/var/lib/pgi-voice/cdr
PGI_TELEPHONY_USER=
PGI_TELEPHONY_PASSWORD=
