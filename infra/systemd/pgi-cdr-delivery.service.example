[Unit]
Description=PGI independent FreeSWITCH CDR delivery
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pgi-voice
Group=pgi-voice
EnvironmentFile=/etc/pgi-voice/cdr-delivery.env
WorkingDirectory=/opt/pgi-telecom
ExecStart=/usr/bin/flock -n /var/lib/pgi-voice/cdr/pipeline.lock /usr/bin/node /opt/pgi-telecom/telephony/cdr-pipeline.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/pgi-voice/cdr /var/lib/pgi-voice/native-cdr
TimeoutStartSec=1200
